---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Docs title={entry.data.title} description={entry.data.description}>
  <h1>{entry.data.title}</h1>
  {entry.data.description && <p class="lede">{entry.data.description}</p>}
  <Content />
  <Fragment slot="toc">
    <ul>
      {toc.map((h) => (
        <li>
          <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : ''}>{h.text}</a>
        </li>
      ))}
    </ul>
  </Fragment>
</Docs>

<style>
  .toc :global(.toc-h3) { padding-left: 12px; }
</style>
