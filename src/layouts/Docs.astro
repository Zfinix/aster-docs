---
import '../../src/styles/docs.css';
import { sidebar, neighbors } from '../lib/sidebar';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Aster documentation' } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/docs/';
const { prev, next } = neighbors(current);
const groupOf = (href: string) => sidebar.find((g) => g.items.some((i) => i.href === href))?.title ?? 'Docs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title} · Aster Docs</title>
    <script is:inline src="/pagefind/pagefind.js"></script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <button class="menu-btn" id="menu-btn" aria-label="Toggle navigation">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
        </button>
        <a class="brand" href="https://withaster.dev">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="6" height="6" fill="#E8613C"/>
            <rect x="9" y="1" width="6" height="6" fill="#141413"/>
            <rect x="17" y="1" width="6" height="6" fill="#141413"/>
            <rect x="1" y="9" width="6" height="6" fill="#141413"/>
            <rect x="9" y="9" width="6" height="6" fill="#E8613C"/>
            <rect x="17" y="9" width="6" height="6" fill="#141413"/>
            <rect x="1" y="17" width="6" height="6" fill="#141413"/>
            <rect x="9" y="17" width="6" height="6" fill="#141413"/>
            <rect x="17" y="17" width="6" height="6" fill="#E8613C"/>
          </svg>
          <span>Aster</span>
          <span class="slash">/</span>
          <span class="docs-word">Docs</span>
        </a>
        <div class="topbar-search">
          <div class="search-wrap">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5"/><path d="m11 11 3.5 3.5"/></svg>
            <input id="search-input" type="search" placeholder="Search docs…" autocomplete="off" spellcheck="false" />
          </div>
        </div>
        <nav class="topbar-links">
          <a href="https://withaster.dev">Home</a>
          <a href="https://github.com/Zfinix/aster">GitHub</a>
        </nav>
      </div>
    </header>

    <div class="search-results" id="search-results">
      <div class="inner" id="search-results-inner"></div>
    </div>

    <div class="shell">
      <aside class="sidebar" id="sidebar">
        {sidebar.map((group) => (
          <div class="sidebar-group">
            <h4>{group.title}</h4>
            <ul>
              {group.items.map((item) => {
                const active = item.href === current;
                return (
                  <li>
                    <a href={item.href} class={active ? 'active' : ''} aria-current={active ? 'page' : undefined}>
                      {item.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </aside>

      <main class="article">
        <div class="breadcrumbs">
          <a href="https://withaster.dev">Aster</a> / <a href="/docs/">Docs</a> / {groupOf(current)}
        </div>
        <slot />
        <nav class="pager">
          {prev ? (
            <a class="prev" href={prev.href}>
              <div class="dir">← Previous</div>
              <div class="label">{prev.title}</div>
            </a>
          ) : <span />}
          {next ? (
            <a class="next" href={next.href}>
              <div class="dir">Next →</div>
              <div class="label">{next.title}</div>
            </a>
          ) : <span />}
        </nav>
      </main>

      <aside class="toc" id="toc">
        <div class="toc-title">On this page</div>
        <slot name="toc" />
      </aside>
    </div>

    <footer class="foot">
      <div class="foot-inner">
        <span>© {new Date().getFullYear()} Aster</span>
        <span class="spacer" />
        <a href="https://github.com/Zfinix/aster">Source</a>
        <a href="https://github.com/Zfinix/aster-docs">Docs source</a>
        <a href="https://withaster.dev">withaster.dev</a>
      </div>
    </footer>

    <script>
      // mobile sidebar
      const btn = document.getElementById('menu-btn');
      const sidebarEl = document.getElementById('sidebar');
      btn?.addEventListener('click', () => sidebarEl?.classList.toggle('open'));

      // copy buttons on code blocks
      for (const pre of document.querySelectorAll('.article pre')) {
        const btnEl = document.createElement('button');
        btnEl.className = 'copy-btn';
        btnEl.textContent = 'copy';
        btnEl.addEventListener('click', async () => {
          const text = pre.querySelector('code')?.textContent ?? '';
          await navigator.clipboard.writeText(text);
          btnEl.textContent = 'copied';
          btnEl.classList.add('ok');
          setTimeout(() => { btnEl.textContent = 'copy'; btnEl.classList.remove('ok'); }, 1500);
        });
        pre.appendChild(btnEl);
      }

      // TOC scroll-spy
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
      if (tocLinks.length) {
        const map = new Map(tocLinks.map((a) => [a.hash.slice(1), a]));
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              tocLinks.forEach((a) => a.classList.remove('active'));
              map.get(e.target.id)?.classList.add('active');
            }
          }
        }, { rootMargin: '-72px 0px -70% 0px' });
        for (const id of map.keys()) {
          const el = document.getElementById(id);
          if (el) obs.observe(el);
        }
      }

      // pagefind search
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const panel = document.getElementById('search-results');
      const inner = document.getElementById('search-results-inner');
      let pagefind: any = null;
      async function loadPagefind() {
        if (!pagefind) pagefind = await (window as any).pagefind;
        return pagefind;
      }
      input?.addEventListener('input', async () => {
        const q = input.value.trim();
        if (!panel || !inner) return;
        if (q.length < 2) { panel.classList.remove('open'); return; }
        try {
          const pf = await loadPagefind();
          const search = await pf.search(q);
          const results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
          inner.innerHTML = '';
          if (!results.length) {
            inner.innerHTML = '<div class="none">No results. Try different words.</div>';
          }
          for (const r of results) {
            const a = document.createElement('a');
            a.className = 'result';
            a.href = r.url;
            a.innerHTML = `<div class="r-title">${r.meta?.title ?? r.url}</div><div class="r-body">${r.excerpt}</div>`;
            inner.appendChild(a);
          }
          panel.classList.add('open');
        } catch {
          /* pagefind not loaded yet */
        }
      });
      document.addEventListener('click', (e) => {
        if (panel && !panel.contains(e.target as Node) && e.target !== input) panel.classList.remove('open');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') panel?.classList.remove('open');
        if (e.key === '/' && document.activeElement !== input) {
          e.preventDefault();
          input?.focus();
        }
      });
    </script>
  </body>
</html>
